 # Database fetch source.
-VORTEX_FETCH_DB_SOURCE=url
+VORTEX_FETCH_DB_SOURCE=gdrive
 
-# Database dump file sourced from a URL.
+# Database dump file sourced from Google Drive.
+
+# Google Drive folder ID with the database dump file.
 #
-# HTTP Basic Authentication credentials should be embedded into the value.
-VORTEX_FETCH_DB_URL=
+# The ID is the last segment of the folder URL. The folder must be in a shared
+# drive and shared with the service account.
+VORTEX_FETCH_DB_GDRIVE_FOLDER_ID=
 
+# Source of the database dump file the nightly CI job sanitizes and pushes to
+# the database fetch source: url, ftp, acquia or lagoon. The fetch script of
+# that source reads its own variables, such as VORTEX_FETCH_DB_URL for url.
+# Add them, and keep secrets in CI.
+# VORTEX_REFRESH_DB_SOURCE=url
+
 # Environment to fetch the database from.
