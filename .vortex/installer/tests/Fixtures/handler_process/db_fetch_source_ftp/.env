@@ -180,12 +180,27 @@
 VORTEX_DB_FILE=db.sql
 
 # Database fetch source.
-VORTEX_FETCH_DB_SOURCE=url
+VORTEX_FETCH_DB_SOURCE=ftp
 
-# Database dump file sourced from a URL.
+# Database dump file sourced from FTP.
+
+# Database dump FTP host.
+VORTEX_FETCH_DB_FTP_HOST=
+
+# Database dump FTP port.
+VORTEX_FETCH_DB_FTP_PORT=21
+
+# Database dump FTP file name.
+VORTEX_FETCH_DB_FTP_FILE=db.sql
+
+# Upstream source of the database dump file, such as url, acquia or lagoon.
 #
-# HTTP Basic Authentication credentials should be embedded into the value.
-VORTEX_FETCH_DB_URL=
+# Uncomment to make the database fetch source a dump store: the nightly CI
+# job fetches the dump from this source, sanitizes it and pushes it to the
+# fetch source, keeping the dump it replaces as the previous one. The fetch
+# script of this source reads its own variables, such as VORTEX_FETCH_DB_URL
+# for url. Add them, and keep secrets in CI.
+# VORTEX_REFRESH_DB_SOURCE=url
 
 # Environment to fetch the database from.
 #
