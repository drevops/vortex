@@ -206,6 +206,52 @@
 VORTEX_FETCH_DB_ENVIRONMENT=prod
 
 ################################################################################
+#                       SECOND DATABASE (MIGRATION)                            #
+################################################################################
+
+# Second database for migrations.
+# See settings.migration.php for database credentials.
+
+# Second database dump file name.
+VORTEX_FETCH_DB2_FILE=db2.sql
+
+# Second database fetch source.
+VORTEX_FETCH_DB2_SOURCE=ftp
+
+# Second database dump file sourced from FTP.
+
+# Second database dump FTP host.
+VORTEX_FETCH_DB2_FTP_HOST=
+
+# Second database dump FTP port.
+VORTEX_FETCH_DB2_FTP_PORT=21
+
+# Second database dump FTP directory.
+#
+# Leave empty for the root directory of the FTP account.
+VORTEX_FETCH_DB2_FTP_DIR=
+
+# Second database dump FTP file name.
+VORTEX_FETCH_DB2_FTP_FILE=db2.sql
+
+# Upstream source of the second database dump file, such as url or lagoon.
+#
+# Uncomment to make the second database fetch source a dump store: the
+# nightly CI job fetches the dump from this source and pushes it, as fetched,
+# to the fetch source, next to the primary dump.
+# VORTEX_REFRESH_DB2_SOURCE=url
+
+# Destinations the nightly CI job pushes the second database dump to, as
+# fetched: ftp, s3 or both. Defaults to the second database fetch source when
+# it is a dump store.
+# VORTEX_PUSH_DB2_DESTINATIONS=ftp,s3
+
+# Environment to fetch the second database from.
+#
+# Applies to hosting environments.
+VORTEX_FETCH_DB2_ENVIRONMENT=prod
+
+################################################################################
 #                             FILES SOURCE                                     #
 ################################################################################
 
