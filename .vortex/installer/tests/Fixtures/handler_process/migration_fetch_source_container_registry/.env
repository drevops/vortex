@@ -206,6 +206,44 @@
 VORTEX_FETCH_DB_ENVIRONMENT=prod
 
 ################################################################################
+#                       SECOND DATABASE (MIGRATION)                            #
+################################################################################
+
+# Second database for migrations.
+# See settings.migration.php for database credentials.
+
+# Second database dump file name.
+VORTEX_FETCH_DB2_FILE=db2.sql
+
+# Second database fetch source.
+VORTEX_FETCH_DB2_SOURCE=container_registry
+
+# Name of the pre-built migration database container image.
+# @see https://github.com/drevops/database-data-images to seed your DB image.
+VORTEX_DB2_IMAGE=the_empire/star_wars-migration:latest
+
+# Rebuild the migration database container image in VORTEX_DB2_IMAGE from the
+# second database dump file in the nightly CI job. Disabled when unset.
+# VORTEX_REFRESH_DB2_PROCEED=1
+
+# Source of the second database dump file the nightly CI job imports into a
+# clean base image to rebuild the migration database container image: url,
+# ftp, acquia, lagoon or s3. The fetch script of that source reads its own
+# variables, such as VORTEX_FETCH_DB2_URL for url. Add them, and keep secrets
+# in CI.
+# VORTEX_REFRESH_DB2_SOURCE=url
+
+# Destinations the nightly CI job pushes the second database dump to, as
+# fetched: ftp, s3 or both. Defaults to the second database fetch source when
+# it is a dump store.
+# VORTEX_PUSH_DB2_DESTINATIONS=ftp,s3
+
+# Environment to fetch the second database from.
+#
+# Applies to hosting environments.
+VORTEX_FETCH_DB2_ENVIRONMENT=prod
+
+################################################################################
 #                             FILES SOURCE                                     #
 ################################################################################
 
