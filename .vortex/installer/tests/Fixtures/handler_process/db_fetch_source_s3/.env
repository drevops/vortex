@@ -180,12 +180,24 @@
 VORTEX_DB_FILE=db.sql
 
 # Database fetch source.
-VORTEX_FETCH_DB_SOURCE=url
+VORTEX_FETCH_DB_SOURCE=s3
 
-# Database dump file sourced from a URL.
+# Database dump file sourced from S3.
+
+# AWS S3 bucket name for database fetch.
+VORTEX_FETCH_DB_S3_BUCKET=
+
+# AWS S3 region.
+VORTEX_FETCH_DB_S3_REGION=ap-southeast-2
+
+# Upstream source of the database dump file, such as url, acquia or lagoon.
 #
-# HTTP Basic Authentication credentials should be embedded into the value.
-VORTEX_FETCH_DB_URL=
+# Uncomment to make the database fetch source a dump store: the nightly CI
+# job fetches the dump from this source, sanitizes it and pushes it to the
+# fetch source as the latest dump. The fetch script of this source reads its
+# own variables, such as VORTEX_FETCH_DB_URL for url. Add them, and keep
+# secrets in CI.
+# VORTEX_REFRESH_DB_SOURCE=url
 
 # Destinations the nightly CI job pushes the sanitized database dump to:
 # ftp, s3 or both, such as "ftp,s3". Defaults to the database fetch source
@@ -265,17 +277,3 @@
