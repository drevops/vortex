#!/usr/bin/env php
<?php

/**
 * @file
 * Update Vortex from the template repository.
 *
 * IMPORTANT! This script runs outside the container on the host system.
 */

declare(strict_types=1);

namespace DrevOps\VortexTooling;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------

// Vortex remote or local template repo URI, optionally including reference.
//
// Examples:
// https://github.com/drevops/vortex.git          # Latest stable tag from remote.
// https://github.com/drevops/vortex.git#stable   # Latest stable tag from remote.
// https://github.com/drevops/vortex.git#1.2.3    # Specific release from remote.
// file:///local/path/to/vortex.git               # Latest stable tag from local.
// /local/path/to/vortex.git#1.2.3                # Specific release from local.
$template_repo = getenv_default('VORTEX_CLI_TEMPLATE_REPO', 'VORTEX_INSTALLER_TEMPLATE_REPO', 'https://github.com/drevops/vortex.git#stable');

// The URL of the Vortex CLI.
$cli_url = getenv_default('VORTEX_CLI_URL', 'VORTEX_INSTALLER_URL', 'https://www.vortextemplate.com/v1/install');

// Cache busting parameter for the CLI URL.
$cli_url_cache_bust = getenv_default('VORTEX_CLI_URL_CACHE_BUST', 'VORTEX_INSTALLER_URL_CACHE_BUST', (string) time());

// The path to the Vortex CLI.
//
// If set, this will override the VORTEX_CLI_URL.
$cli_path = getenv_default('VORTEX_CLI_PATH', 'VORTEX_INSTALLER_PATH', '');

// Run the update in interactive mode.
$interactive = getenv_default('VORTEX_CLI_INTERACTIVE', 'VORTEX_INSTALLER_INTERACTIVE', '0');

// -----------------------------------------------------------------------------

command_must_exist('php');

// Parse arguments.
foreach (array_slice($GLOBALS['argv'] ?? [], 1) as $arg) {
  if ($arg === '--interactive') {
    $interactive = '1';
  }
  else {
    $template_repo = $arg;
  }
}

// A CLI provided by the caller is theirs to keep; only a copy downloaded here
// is removed once the update finishes.
$downloaded = FALSE;

if ($cli_path !== '') {
  NOTE('Using Vortex CLI from local path: %s', $cli_path);
  if (!file_exists($cli_path)) {
    FAIL('Vortex CLI not found at %s', $cli_path);
  }
}
else {
  NOTE('Using Vortex CLI from URL: %s', $cli_url);
  $cli_path = 'vortex.phar';
  $downloaded = TRUE;

  TASK(sprintf('Downloading Vortex CLI to %s.', $cli_path), sprintf('Downloaded Vortex CLI to %s.', $cli_path), function () use ($cli_url, $cli_url_cache_bust, $cli_path): void {
    $separator = str_contains($cli_url, '?') ? '&' : '?';
    $response = request($cli_url . $separator . $cli_url_cache_bust, ['method' => 'GET', 'save_to' => $cli_path, 'timeout' => 30]);

    if (!$response['ok']) {
      throw new \RuntimeException(sprintf('Failed to download Vortex CLI from %s', $cli_url));
    }
  });
}

// Capture the exit code by reference and quit after the task returns, so the
// task line is closed and the CLI's exit code is still propagated.
$exit_code = 0;
TASK('Running the update.', 'Finished running the update.', function () use ($interactive, $cli_path, $template_repo, &$exit_code): void {
  $flags = $interactive === '0' ? ' --no-interaction' : '';

  passthru(sprintf('php %s update%s --uri=%s', escapeshellarg($cli_path), $flags, escapeshellarg($template_repo)), $exit_code);

  if ($exit_code !== 0) {
    throw new \RuntimeException('The update run failed.');
  }
}, fatal: FALSE);

if ($downloaded && file_exists($cli_path)) {
  unlink($cli_path);
}

quit($exit_code);
