#!/usr/bin/env php
<?php

/**
 * @file
 * Update Vortex from the template repository.
 *
 * IMPORTANT! This script runs outside the container on the host system.
 */

declare(strict_types=1);

namespace DrevOps\VortexTooling;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------

// Vortex remote or local template repo URI, optionally including reference.
//
// Examples:
// https://github.com/drevops/vortex.git          # Latest stable tag from remote.
// https://github.com/drevops/vortex.git#stable   # Latest stable tag from remote.
// https://github.com/drevops/vortex.git#1.2.3    # Specific release from remote.
// file:///local/path/to/vortex.git               # Latest stable tag from local.
// /local/path/to/vortex.git#1.2.3                # Specific release from local.
$template_repo = getenv_default('VORTEX_CLI_INSTALL_TEMPLATE_REPO', 'VORTEX_INSTALLER_TEMPLATE_REPO', 'https://github.com/drevops/vortex.git#stable');

// The URL of the Vortex CLI.
//
// Pinned to the major-specific path so an existing project always updates
// within its own major line, and so the downloaded build is one that carries
// the commands this script calls. The bare '/install' tracks the active major
// and would jump a project across a major boundary.
$cli_url = getenv_default('VORTEX_CLI_URL', 'VORTEX_INSTALLER_URL', 'https://www.vortextemplate.com/v2/install');

// Cache busting parameter for the CLI URL.
$cli_url_cache_bust = getenv_default('VORTEX_CLI_URL_CACHE_BUST', 'VORTEX_INSTALLER_URL_CACHE_BUST', (string) time());

// The path to the Vortex CLI.
//
// If set, this will override the VORTEX_CLI_URL.
$cli_path = getenv_default('VORTEX_CLI_PATH', 'VORTEX_INSTALLER_PATH', '');

// Run the CLI in interactive mode.
$interactive = getenv_default('VORTEX_CLI_INSTALL_INTERACTIVE', 'VORTEX_INSTALLER_INTERACTIVE', '0');

// -----------------------------------------------------------------------------

command_must_exist('php');

// The superseded names above still resolve through the fallback, so warn when
// one of them is what actually supplied a value.
foreach ([
  'VORTEX_INSTALLER_TEMPLATE_REPO' => 'VORTEX_CLI_INSTALL_TEMPLATE_REPO',
  'VORTEX_INSTALLER_URL' => 'VORTEX_CLI_URL',
  'VORTEX_INSTALLER_URL_CACHE_BUST' => 'VORTEX_CLI_URL_CACHE_BUST',
  'VORTEX_INSTALLER_PATH' => 'VORTEX_CLI_PATH',
  'VORTEX_INSTALLER_INTERACTIVE' => 'VORTEX_CLI_INSTALL_INTERACTIVE',
] as $legacy => $current) {
  if (getenv_default($current, '') === '' && getenv_default($legacy, '') !== '') {
    NOTE('%s is deprecated and will be removed in a future release. Use %s instead.', $legacy, $current);
  }
}

// Parse arguments.
foreach (array_slice($GLOBALS['argv'] ?? [], 1) as $arg) {
  if ($arg === '--interactive') {
    $interactive = '1';
  }
  else {
    $template_repo = $arg;
  }
}

if ($cli_path !== '') {
  NOTE('Using Vortex CLI from local path: %s', $cli_path);
  if (!file_exists($cli_path)) {
    FAIL('Vortex CLI not found at %s', $cli_path);
  }
}
else {
  NOTE('Using Vortex CLI from URL: %s', $cli_url);
  $cli_path = 'vortex.phar';

  TASK(sprintf('Downloading Vortex CLI to %s.', $cli_path), sprintf('Downloaded Vortex CLI to %s.', $cli_path), function () use ($cli_url, $cli_url_cache_bust, $cli_path): void {
    $separator = str_contains($cli_url, '?') ? '&' : '?';
    $response = request($cli_url . $separator . $cli_url_cache_bust, ['method' => 'GET', 'save_to' => $cli_path, 'timeout' => 30]);

    if (!$response['ok']) {
      throw new \RuntimeException(sprintf('Failed to download Vortex CLI from %s', $cli_url));
    }
  });
}

// Capture the exit code by reference and quit after the task returns, so the
// task line is closed and the CLI's exit code is still propagated.
$exit_code = 0;
TASK('Running the Vortex CLI.', 'Finished running the Vortex CLI.', function () use ($interactive, $cli_path, $template_repo, &$exit_code): void {
  if ($interactive === '0') {
    passthru(sprintf('php %s update --no-interaction --uri=%s', escapeshellarg($cli_path), escapeshellarg($template_repo)), $exit_code);
  }
  else {
    passthru(sprintf('php %s update --uri=%s', escapeshellarg($cli_path), escapeshellarg($template_repo)), $exit_code);
  }

  if ($exit_code !== 0) {
    throw new \RuntimeException('The Vortex CLI run failed.');
  }
}, fatal: FALSE);

quit($exit_code);
