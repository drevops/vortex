#!/usr/bin/env bash
##
# Push DB dump to FTP.
#
# Uploads the database dump file under the remote file name, such as
# 'db.sql', which always holds the latest dump that the fetch downloads. With
# VORTEX_PUSH_DB_TIMESTAMPED_COPY set to 1, the dump is also uploaded under a
# name with a UTC timestamp, such as 'db_20261111-180000.sql', to keep a
# history.
#
# Each file is uploaded under a temporary name and renamed into place only
# after the upload succeeds, so a failed upload keeps the existing file.
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu

# Database index suffix. When set (e.g., "2"), all DB-related variable lookups
# use the indexed variant, so each database pushes its own dump file.
_db_index="${VORTEX_DB_INDEX:-}"

# The FTP values fall back to the values the database is fetched with, so a
# server used as the fetch source is configured once.

# The FTP user.
_v="VORTEX_PUSH_DB${_db_index}_FTP_USER"
_vs="VORTEX_FETCH_DB${_db_index}_FTP_USER"
VORTEX_PUSH_DB_FTP_USER="${!_v:-${!_vs:-}}"

# The FTP password.
_v="VORTEX_PUSH_DB${_db_index}_FTP_PASS"
_vs="VORTEX_FETCH_DB${_db_index}_FTP_PASS"
VORTEX_PUSH_DB_FTP_PASS="${!_v:-${!_vs:-}}"

# The FTP host.
_v="VORTEX_PUSH_DB${_db_index}_FTP_HOST"
_vs="VORTEX_FETCH_DB${_db_index}_FTP_HOST"
VORTEX_PUSH_DB_FTP_HOST="${!_v:-${!_vs:-}}"

# The FTP port.
_v="VORTEX_PUSH_DB${_db_index}_FTP_PORT"
_vs="VORTEX_FETCH_DB${_db_index}_FTP_PORT"
VORTEX_PUSH_DB_FTP_PORT="${!_v:-${!_vs:-21}}"

# The remote file name, including any directories.
_v="VORTEX_PUSH_DB${_db_index}_FTP_FILE"
_vs="VORTEX_FETCH_DB${_db_index}_FTP_FILE"
VORTEX_PUSH_DB_FTP_FILE="${!_v:-${!_vs:-}}"

# Directory with database dump file.
_v="VORTEX_PUSH_DB${_db_index}_FTP_DB_DIR"
_vs="VORTEX_FETCH_DB${_db_index}_DIR"
_vss="VORTEX_DB${_db_index}_DIR"
VORTEX_PUSH_DB_FTP_DB_DIR="${!_v:-${!_vs:-${!_vss:-${VORTEX_DB_DIR:-./.data}}}}"

# Database dump file name.
#
# Defaults to the name the database is fetched and refreshed with.
_v="VORTEX_PUSH_DB${_db_index}_FTP_DB_FILE"
_vs="VORTEX_FETCH_DB${_db_index}_FILE"
_vss="VORTEX_DB${_db_index}_FILE"
VORTEX_PUSH_DB_FTP_DB_FILE="${!_v:-${!_vs:-${!_vss:-${VORTEX_DB_FILE:-db.sql}}}}"

# Suffix for the names of the pushed database dump files.
#
# Goes before the extension, so 'db.sql' becomes 'db_gha.sql' with '_gha'.
# Use a different suffix in each place that pushes to the same storage. A
# fetch reads the suffixed name only when its remote file name includes it.
VORTEX_PUSH_DB_FILE_SUFFIX="${VORTEX_PUSH_DB_FILE_SUFFIX:-}"

# Also push a copy of the database dump file named with a UTC timestamp.
#
# Set to 1 to keep a history of the pushed dumps. The fetch never reads the
# timestamped copies.
VORTEX_PUSH_DB_TIMESTAMPED_COPY="${VORTEX_PUSH_DB_TIMESTAMPED_COPY:-}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

# Print a value quoted for a curl config file.
curl_config_quote() {
  local value="${1//\\/\\\\}"
  printf '"%s"' "${value//\"/\\\"}"
}

# Upload the database dump file to a name in the remote directory.
#
# The credentials go to curl on stdin, so they never appear in the process
# list. The commands after the upload run in the remote directory: the
# existing file is removed and the upload takes its name.
ftp_upload() {
  local name="${1}"
  local upload_name="${name}.uploading"

  echo "user = $(curl_config_quote "${VORTEX_PUSH_DB_FTP_USER}:${VORTEX_PUSH_DB_FTP_PASS}")" | curl --silent --show-error --config - --ftp-create-dirs --upload-file "${local_file}" \
    --quote "-*DELE ${name}" \
    --quote "-RNFR ${upload_name}" \
    --quote "-RNTO ${name}" \
    "ftp://${VORTEX_PUSH_DB_FTP_HOST}:${VORTEX_PUSH_DB_FTP_PORT}/${remote_dir}${upload_name}"
}

# shellcheck disable=SC2043
for cmd in curl; do command -v "${cmd}" >/dev/null || fail "Command ${cmd} is not available."; done

[ -z "${VORTEX_PUSH_DB_FTP_USER}" ] && fail "Missing required value for VORTEX_PUSH_DB${_db_index}_FTP_USER or VORTEX_FETCH_DB${_db_index}_FTP_USER."
[ -z "${VORTEX_PUSH_DB_FTP_PASS}" ] && fail "Missing required value for VORTEX_PUSH_DB${_db_index}_FTP_PASS or VORTEX_FETCH_DB${_db_index}_FTP_PASS."
[ -z "${VORTEX_PUSH_DB_FTP_HOST}" ] && fail "Missing required value for VORTEX_PUSH_DB${_db_index}_FTP_HOST or VORTEX_FETCH_DB${_db_index}_FTP_HOST."
[ -z "${VORTEX_PUSH_DB_FTP_FILE}" ] && fail "Missing required value for VORTEX_PUSH_DB${_db_index}_FTP_FILE or VORTEX_FETCH_DB${_db_index}_FTP_FILE."

local_file="${VORTEX_PUSH_DB_FTP_DB_DIR}/${VORTEX_PUSH_DB_FTP_DB_FILE}"
[ ! -f "${local_file}" ] && fail "Database dump file ${local_file} does not exist."

remote_dir=""
remote_name="${VORTEX_PUSH_DB_FTP_FILE#/}"
if [[ ${remote_name} == */* ]]; then
  remote_dir="${remote_name%/*}/"
  remote_name="${remote_name##*/}"
fi

base="${remote_name}"
ext=""
if [[ ${remote_name} == *.* ]]; then
  base="${remote_name%.*}"
  ext=".${remote_name##*.}"
fi
current_name="${base}${VORTEX_PUSH_DB_FILE_SUFFIX}${ext}"
timestamped_name="${base}${VORTEX_PUSH_DB_FILE_SUFFIX}_$(date -u +%Y%m%d-%H%M%S)${ext}"

info "Started database${_db_index:+ ${_db_index}} dump push to FTP."

note "Local file:  ${local_file}"
note "Remote file: ${remote_dir}${current_name}"
note "FTP host:    ${VORTEX_PUSH_DB_FTP_HOST}:${VORTEX_PUSH_DB_FTP_PORT}"

task "Uploading the database dump file."
ftp_upload "${current_name}" || fail "Unable to push the database dump file to FTP."
pass "Uploaded the database dump file."

if [ "${VORTEX_PUSH_DB_TIMESTAMPED_COPY}" = "1" ]; then
  # FTP has no copy command, so the copy is a second upload.
  task "Uploading the timestamped copy ${remote_dir}${timestamped_name}."
  ftp_upload "${timestamped_name}" || fail "Unable to push the timestamped copy of the database dump file to FTP."
  pass "Uploaded the timestamped copy ${remote_dir}${timestamped_name}."
fi

# Enable xtrace only after the request so the credentials are never written
# to the trace output.
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

pass "Finished database${_db_index:+ ${_db_index}} dump push to FTP."
