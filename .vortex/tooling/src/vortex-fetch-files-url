#!/usr/bin/env bash
##
# Fetch public files archive via CURL.
#
# The archive is a tar file, optionally compressed, with the content of the
# public files directory at its root.
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

# URL of the public files archive. If HTTP authentication required, it must be
# included in the variable.
VORTEX_FETCH_FILES_URL="${VORTEX_FETCH_FILES_URL:-}"

# Directory the public files are fetched into.
VORTEX_FETCH_FILES_DIR="${VORTEX_FETCH_FILES_DIR:-./${WEBROOT:-web}/sites/default/files}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

for cmd in curl tar; do command -v "${cmd}" >/dev/null || fail "Command ${cmd} is not available."; done

info "Started files fetch from URL."

[ -z "${VORTEX_FETCH_FILES_URL}" ] && fail "Missing required value for VORTEX_FETCH_FILES_URL."

mkdir -p "${VORTEX_FETCH_FILES_DIR}"

archive_file=$(mktemp)
trap 'rm -f "${archive_file}"' EXIT

task "Fetching files archive."
curl -fLs "${VORTEX_FETCH_FILES_URL}" -o "${archive_file}" || fail "Unable to fetch files archive from the URL in VORTEX_FETCH_FILES_URL."
pass "Fetched files archive."

task "Extracting files archive into ${VORTEX_FETCH_FILES_DIR}."
tar -xf "${archive_file}" -C "${VORTEX_FETCH_FILES_DIR}" || fail "Unable to extract files archive into ${VORTEX_FETCH_FILES_DIR}."
pass "Extracted files archive into ${VORTEX_FETCH_FILES_DIR}."

pass "Finished files fetch from URL."
