#!/usr/bin/env bash
##
# Fetch public files from Lagoon environment.
#
# This script will synchronize the public files directory of the specified
# environment into the local public files directory. Local files missing from
# the environment are kept.
#
# It does not rely on 'lagoon-cli', which makes it capable of
# running on hosts without installed lagooncli.
#
# It does require using SSH key added to one of the users in Lagoon who has
# SSH access.
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091,SC2124

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

# Lagoon project name.
VORTEX_FETCH_FILES_LAGOON_PROJECT="${VORTEX_FETCH_FILES_LAGOON_PROJECT:-${LAGOON_PROJECT:?Missing required value for LAGOON_PROJECT.}}"

# The source environment branch for the files source.
#
# Falls back to the database source environment.
VORTEX_FETCH_FILES_ENVIRONMENT="${VORTEX_FETCH_FILES_ENVIRONMENT:-${VORTEX_FETCH_DB_ENVIRONMENT:-main}}"

# SSH key fingerprint used to connect to a remote.
VORTEX_FETCH_FILES_SSH_FINGERPRINT="${VORTEX_FETCH_FILES_SSH_FINGERPRINT:-}"

# Default SSH file used if custom fingerprint is not provided.
VORTEX_FETCH_FILES_SSH_FILE="${VORTEX_FETCH_FILES_SSH_FILE:-${HOME}/.ssh/id_rsa}"

# The SSH host of the Lagoon environment.
VORTEX_FETCH_FILES_LAGOON_SSH_HOST="${VORTEX_FETCH_FILES_LAGOON_SSH_HOST:-ssh.lagoon.amazeeio.cloud}"

# The SSH port of the Lagoon environment.
VORTEX_FETCH_FILES_LAGOON_SSH_PORT="${VORTEX_FETCH_FILES_LAGOON_SSH_PORT:-32222}"

# The SSH user of the Lagoon environment.
VORTEX_FETCH_FILES_LAGOON_SSH_USER="${VORTEX_FETCH_FILES_LAGOON_SSH_USER:-${VORTEX_FETCH_FILES_LAGOON_PROJECT}-${VORTEX_FETCH_FILES_ENVIRONMENT}}"

# Public files directory in the Lagoon environment.
VORTEX_FETCH_FILES_LAGOON_REMOTE_DIR="${VORTEX_FETCH_FILES_LAGOON_REMOTE_DIR:-/app/${WEBROOT:-web}/sites/default/files}"

# Directory the public files are fetched into.
VORTEX_FETCH_FILES_DIR="${VORTEX_FETCH_FILES_DIR:-./${WEBROOT:-web}/sites/default/files}"

# Space-separated list of directories in the public files directory to skip.
#
# The defaults are generated by Drupal and are rebuilt locally on demand.
VORTEX_FETCH_FILES_EXCLUDE="${VORTEX_FETCH_FILES_EXCLUDE-css js php styles}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

for cmd in ssh rsync; do command -v "${cmd}" >/dev/null || fail "Command ${cmd} is not available."; done

info "Started files fetch from Lagoon."

export VORTEX_SSH_PREFIX="FETCH_FILES"
. "$(dirname "${BASH_SOURCE[0]}")/vortex-setup-ssh"

ssh_opts=(-o "UserKnownHostsFile=/dev/null")
ssh_opts+=(-o "StrictHostKeyChecking=no")
ssh_opts+=(-o "LogLevel=error")
ssh_opts+=(-o "IdentitiesOnly=yes")
ssh_opts+=(-p "${VORTEX_FETCH_FILES_LAGOON_SSH_PORT}")
if [ "${VORTEX_FETCH_FILES_SSH_FILE:-}" != false ]; then
  ssh_opts+=(-i "${VORTEX_FETCH_FILES_SSH_FILE}")
fi

mkdir -p "${VORTEX_FETCH_FILES_DIR}"

rsync_opts=(-rltz)
for exclude in ${VORTEX_FETCH_FILES_EXCLUDE}; do
  rsync_opts+=(--exclude "/${exclude}")
done
ssh_opts_string="${ssh_opts[@]}"
rsync_opts+=(-e "ssh ${ssh_opts_string}")

task "Fetching files from ${VORTEX_FETCH_FILES_ENVIRONMENT} environment."
rsync "${rsync_opts[@]}" "${VORTEX_FETCH_FILES_LAGOON_SSH_USER}@${VORTEX_FETCH_FILES_LAGOON_SSH_HOST}:${VORTEX_FETCH_FILES_LAGOON_REMOTE_DIR}/" "${VORTEX_FETCH_FILES_DIR}/"
pass "Fetched files from ${VORTEX_FETCH_FILES_ENVIRONMENT} environment."

pass "Finished files fetch from Lagoon."
