#!/usr/bin/env bash
##
# Fetch public files from Acquia Cloud environment.
#
# This script will discover the SSH address of the specified Acquia Cloud
# environment using Acquia Cloud API 2.0 and synchronize the public files
# directory of that environment into the local public files directory. Local
# files missing from the environment are kept.
#
# It requires Cloud API token Key and Secret to be provided.
# To create a Cloud API token, go to
# Acquia Cloud UI -> Account -> API tokens -> Create Token
#
# It also requires an SSH key added to the Acquia Cloud user profile.
#
# @see https://docs.acquia.com/acquia-cloud/develop/api/auth/#cloud-generate-api-token
# @see https://cloudapi-docs.acquia.com/#/Environments/getEnvironment
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091,SC2124

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

# Acquia Cloud API key.
VORTEX_FETCH_FILES_ACQUIA_KEY="${VORTEX_FETCH_FILES_ACQUIA_KEY:-${VORTEX_ACQUIA_KEY:-}}"

# Acquia Cloud API secret.
VORTEX_FETCH_FILES_ACQUIA_SECRET="${VORTEX_FETCH_FILES_ACQUIA_SECRET:-${VORTEX_ACQUIA_SECRET:-}}"

# Application name. Used to discover UUID.
VORTEX_FETCH_FILES_ACQUIA_APP_NAME="${VORTEX_FETCH_FILES_ACQUIA_APP_NAME:-${VORTEX_ACQUIA_APP_NAME:-}}"

# Source environment name used to fetch the files from.
#
# Falls back to the database source environment.
VORTEX_FETCH_FILES_ENVIRONMENT="${VORTEX_FETCH_FILES_ENVIRONMENT:-${VORTEX_FETCH_DB_ENVIRONMENT:-}}"

# Public files directory in the Acquia environment.
#
# Defaults to '/mnt/files/<sitegroup>.<environment>/sites/default/files'.
VORTEX_FETCH_FILES_ACQUIA_REMOTE_DIR="${VORTEX_FETCH_FILES_ACQUIA_REMOTE_DIR:-}"

# SSH key fingerprint used to connect to a remote.
VORTEX_FETCH_FILES_SSH_FINGERPRINT="${VORTEX_FETCH_FILES_SSH_FINGERPRINT:-}"

# Default SSH file used if custom fingerprint is not provided.
VORTEX_FETCH_FILES_SSH_FILE="${VORTEX_FETCH_FILES_SSH_FILE:-${HOME}/.ssh/id_rsa}"

# Directory the public files are fetched into.
VORTEX_FETCH_FILES_DIR="${VORTEX_FETCH_FILES_DIR:-./${WEBROOT:-web}/sites/default/files}"

# Space-separated list of directories in the public files directory to skip.
#
# The defaults are generated by Drupal and are rebuilt locally on demand.
VORTEX_FETCH_FILES_EXCLUDE="${VORTEX_FETCH_FILES_EXCLUDE-css js php styles}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

extract_json_last_value() {
  local key="${1}"
  php -r "\$data=json_decode(file_get_contents('php://stdin'), TRUE); \$last=array_pop(\$data); isset(\$last[\"${key}\"]) ? print trim(json_encode(\$last[\"${key}\"], JSON_UNESCAPED_SLASHES), '\"') : exit(1);"
}

extract_json_value() {
  local key="${1}"
  php -r "\$data=json_decode(file_get_contents('php://stdin'), TRUE); isset(\$data[\"${key}\"]) ? print trim(json_encode(\$data[\"${key}\"], JSON_UNESCAPED_SLASHES), '\"') : exit(1);"
}

for cmd in php curl ssh rsync; do command -v "${cmd}" >/dev/null || fail "Command ${cmd} is not available."; done

info "Started files fetch from Acquia."

[ -z "${VORTEX_FETCH_FILES_ACQUIA_KEY}" ] && fail "Missing required value for VORTEX_FETCH_FILES_ACQUIA_KEY or VORTEX_ACQUIA_KEY."
[ -z "${VORTEX_FETCH_FILES_ACQUIA_SECRET}" ] && fail "Missing required value for VORTEX_FETCH_FILES_ACQUIA_SECRET or VORTEX_ACQUIA_SECRET."
[ -z "${VORTEX_FETCH_FILES_ACQUIA_APP_NAME}" ] && fail "Missing required value for VORTEX_FETCH_FILES_ACQUIA_APP_NAME or VORTEX_ACQUIA_APP_NAME."
[ -z "${VORTEX_FETCH_FILES_ENVIRONMENT}" ] && fail "Missing required value for VORTEX_FETCH_FILES_ENVIRONMENT or VORTEX_FETCH_DB_ENVIRONMENT."

task "Retrieving authentication token."
token_json=$(curl -s -L https://accounts.acquia.com/api/auth/oauth/token --data-urlencode "client_id=${VORTEX_FETCH_FILES_ACQUIA_KEY}" --data-urlencode "client_secret=${VORTEX_FETCH_FILES_ACQUIA_SECRET}" --data-urlencode "grant_type=client_credentials")
[ "${VORTEX_DEBUG-}" = "1" ] && note "Token API response received (token redacted)."

if echo "${token_json}" | grep -q '"error"'; then
  fail "Authentication failed. Check VORTEX_FETCH_FILES_ACQUIA_KEY or VORTEX_ACQUIA_KEY and VORTEX_FETCH_FILES_ACQUIA_SECRET or VORTEX_ACQUIA_SECRET. API response: ${token_json}"
fi

token=$(echo "${token_json}" | extract_json_value "access_token")
[ "${VORTEX_DEBUG-}" = "1" ] && note "Access token extracted (value redacted)."
[ -z "${token}" ] && fail "Unable to retrieve a token. API response: ${token_json}"
pass "Retrieved authentication token."

task "Retrieving ${VORTEX_FETCH_FILES_ACQUIA_APP_NAME} application UUID."
app_uuid_json=$(curl -s -L -H 'Accept: application/json, version=2' -H "Authorization: Bearer ${token}" "https://cloud.acquia.com/api/applications?filter=name%3D${VORTEX_FETCH_FILES_ACQUIA_APP_NAME/ /%20}")
[ "${VORTEX_DEBUG-}" = "1" ] && note "Application API response: ${app_uuid_json}"

if echo "${app_uuid_json}" | grep -q '"items":\[\]'; then
  fail "Application \"${VORTEX_FETCH_FILES_ACQUIA_APP_NAME}\" not found. Check application name and access permissions."
fi

app_uuid=$(echo "${app_uuid_json}" | extract_json_value "_embedded" | extract_json_value "items" | extract_json_last_value "uuid")
[ "${VORTEX_DEBUG-}" = "1" ] && note "Extracted app UUID: ${app_uuid}"
[ -z "${app_uuid}" ] && fail "Unable to retrieve an application UUID for \"${VORTEX_FETCH_FILES_ACQUIA_APP_NAME}\". API response: ${app_uuid_json}"
pass "Retrieved ${VORTEX_FETCH_FILES_ACQUIA_APP_NAME} application UUID."

task "Retrieving ${VORTEX_FETCH_FILES_ENVIRONMENT} environment SSH address."
envs_json=$(curl -s -L -H 'Accept: application/json, version=2' -H "Authorization: Bearer ${token}" "https://cloud.acquia.com/api/applications/${app_uuid}/environments?filter=name%3D${VORTEX_FETCH_FILES_ENVIRONMENT}")
[ "${VORTEX_DEBUG-}" = "1" ] && note "Environments API response: ${envs_json}"

if echo "${envs_json}" | grep -q '"items":\[\]'; then
  fail "Environment \"${VORTEX_FETCH_FILES_ENVIRONMENT}\" not found in application \"${VORTEX_FETCH_FILES_ACQUIA_APP_NAME}\". Check environment name."
fi

ssh_url=$(echo "${envs_json}" | extract_json_value "_embedded" | extract_json_value "items" | extract_json_last_value "ssh_url" || true)
[ "${VORTEX_DEBUG-}" = "1" ] && note "Extracted SSH address: ${ssh_url}"
[ -z "${ssh_url}" ] && fail "Unable to retrieve SSH address for \"${VORTEX_FETCH_FILES_ENVIRONMENT}\" environment. API response: ${envs_json}"
pass "Retrieved ${VORTEX_FETCH_FILES_ENVIRONMENT} environment SSH address."

# The SSH user is '<sitegroup>.<environment>', which also names the files
# mount of the environment.
ssh_user="${ssh_url%%@*}"
remote_dir="${VORTEX_FETCH_FILES_ACQUIA_REMOTE_DIR:-/mnt/files/${ssh_user}/sites/default/files}"

export VORTEX_SSH_PREFIX="FETCH_FILES"
. "$(dirname "${BASH_SOURCE[0]}")/vortex-setup-ssh"

ssh_opts=(-o "UserKnownHostsFile=/dev/null")
ssh_opts+=(-o "StrictHostKeyChecking=no")
ssh_opts+=(-o "LogLevel=error")
ssh_opts+=(-o "IdentitiesOnly=yes")
if [ "${VORTEX_FETCH_FILES_SSH_FILE:-}" != false ]; then
  ssh_opts+=(-i "${VORTEX_FETCH_FILES_SSH_FILE}")
fi

mkdir -p "${VORTEX_FETCH_FILES_DIR}"

rsync_opts=(-rltz)
for exclude in ${VORTEX_FETCH_FILES_EXCLUDE}; do
  rsync_opts+=(--exclude "/${exclude}")
done
ssh_opts_string="${ssh_opts[@]}"
rsync_opts+=(-e "ssh ${ssh_opts_string}")

task "Fetching files from ${VORTEX_FETCH_FILES_ENVIRONMENT} environment."
rsync "${rsync_opts[@]}" "${ssh_url}:${remote_dir}/" "${VORTEX_FETCH_FILES_DIR}/"
pass "Fetched files from ${VORTEX_FETCH_FILES_ENVIRONMENT} environment."

pass "Finished files fetch from Acquia."
