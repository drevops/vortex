#!/usr/bin/env bash
##
# Fetch DB dump from container image.
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091,SC2015

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

# Database index suffix. When set (e.g., "2"), all DB-related variable lookups
# use the indexed variant (e.g., VORTEX_DB2_IMAGE instead of VORTEX_DB_IMAGE).
_db_index="${VORTEX_DB_INDEX:-}"

# The container image containing database passed in a form of `<org>/<repository>`.
_v="VORTEX_FETCH_DB${_db_index}_CONTAINER_REGISTRY_IMAGE"
_vs="VORTEX_DB${_db_index}_IMAGE"
VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE="${!_v:-${!_vs:-}}"

# Container registry name.
#
# Provide port, if required as `<server_name>:<port>`.
_v="VORTEX_FETCH_DB${_db_index}_CONTAINER_REGISTRY"
VORTEX_FETCH_DB_CONTAINER_REGISTRY="${!_v:-${VORTEX_CONTAINER_REGISTRY:-docker.io}}"

# The username to login into the container registry.
_v="VORTEX_FETCH_DB${_db_index}_CONTAINER_REGISTRY_USER"
VORTEX_FETCH_DB_CONTAINER_REGISTRY_USER="${!_v:-${VORTEX_CONTAINER_REGISTRY_USER:-}}"

# The password to login into the container registry.
_v="VORTEX_FETCH_DB${_db_index}_CONTAINER_REGISTRY_PASS"
VORTEX_FETCH_DB_CONTAINER_REGISTRY_PASS="${!_v:-${VORTEX_CONTAINER_REGISTRY_PASS:-}}"

# Base container image to tag as the database container image.
#
# When set, the base image is pulled and tagged as the database container
# image instead of fetching the database container image.
_v="VORTEX_FETCH_DB${_db_index}_CONTAINER_REGISTRY_IMAGE_BASE"
VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE="${!_v:-}"

# Force fetch even if the image already exists on the host.
_v="VORTEX_FETCH_DB${_db_index}_FORCE"
VORTEX_FETCH_DB_FORCE="${!_v:-}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

# shellcheck disable=SC2043
for cmd in docker; do command -v "${cmd}" >/dev/null || fail "Command ${cmd} is not available."; done

info "Started database data container image fetch."

[ -z "${VORTEX_FETCH_DB_CONTAINER_REGISTRY}" ] && fail "Missing required value for VORTEX_FETCH_DB_CONTAINER_REGISTRY or VORTEX_CONTAINER_REGISTRY."
[ -z "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_USER}" ] && fail "Missing required value for VORTEX_FETCH_DB_CONTAINER_REGISTRY_USER or VORTEX_CONTAINER_REGISTRY_USER."
[ -z "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_PASS}" ] && fail "Missing required value for VORTEX_FETCH_DB_CONTAINER_REGISTRY_PASS or VORTEX_CONTAINER_REGISTRY_PASS."
[ -z "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}" ] && fail "Missing required value for VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE or VORTEX_DB_IMAGE."

export VORTEX_CONTAINER_REGISTRY="${VORTEX_FETCH_DB_CONTAINER_REGISTRY}"
export VORTEX_CONTAINER_REGISTRY_USER="${VORTEX_FETCH_DB_CONTAINER_REGISTRY_USER}"
export VORTEX_CONTAINER_REGISTRY_PASS="${VORTEX_FETCH_DB_CONTAINER_REGISTRY_PASS}"

if [ -n "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE}" ]; then
  "$(dirname "${BASH_SOURCE[0]}")/vortex-login-container-registry"

  task "Tagging base image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE} as database container image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}."
  docker pull "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE}" || fail "Unable to pull base image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE}."
  docker tag "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE}" "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}" || fail "Unable to tag base image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE} as database container image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}."
  pass "Tagged base image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE_BASE} as database container image ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}."

  pass "Finished database data container image fetch."
  exit 0
fi

if docker image inspect "${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}" >/dev/null 2>&1; then
  note "Found ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE} image on host."

  if [ "${VORTEX_FETCH_DB_FORCE}" != "1" ]; then
    note "Using existing ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE} image on host."
    note "Fetch will not proceed."
    note "Remove existing image or set VORTEX_FETCH_DB${_db_index}_FORCE value to 1 to force fetch."
    pass "Finished database data container image fetch."
    exit 0
  fi
else
  note "Not found ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE} image on host."
fi

"$(dirname "${BASH_SOURCE[0]}")/vortex-login-container-registry"

task "Fetching ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE} image from the registry."
docker pull "${VORTEX_FETCH_DB_CONTAINER_REGISTRY}/${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE}" || fail "Unable to fetch ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE} image from the registry."
pass "Fetched ${VORTEX_FETCH_DB_CONTAINER_REGISTRY_IMAGE} image from the registry."

pass "Finished database data container image fetch."
