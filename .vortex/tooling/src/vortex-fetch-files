#!/usr/bin/env bash
##
# Fetch public files.
#
# This is a router script to call relevant scripts based on type.
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

# Files fetch source.
VORTEX_FETCH_FILES_SOURCE="${VORTEX_FETCH_FILES_SOURCE:-url}"

# Proceed with fetch.
VORTEX_FETCH_FILES_PROCEED="${VORTEX_FETCH_FILES_PROCEED:-1}"

# Directory the public files are fetched into.
VORTEX_FETCH_FILES_DIR="${VORTEX_FETCH_FILES_DIR:-./${WEBROOT:-web}/sites/default/files}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

info "Started files fetch."

[ "${VORTEX_FETCH_FILES_PROCEED}" != "1" ] && pass "Skipped files fetch as VORTEX_FETCH_FILES_PROCEED is not set to 1." && exit 0

case "${VORTEX_FETCH_FILES_SOURCE}" in
  url) fetch_script="vortex-fetch-files-url" ;;
  acquia) fetch_script="vortex-fetch-files-acquia" ;;
  lagoon) fetch_script="vortex-fetch-files-lagoon" ;;
  none) fetch_script="" ;;
  *) fail "Unsupported files source \"${VORTEX_FETCH_FILES_SOURCE}\" in VORTEX_FETCH_FILES_SOURCE. Use one of: url, acquia, lagoon, none." ;;
esac

if [ -z "${fetch_script}" ]; then
  pass 'Skipped fetching as VORTEX_FETCH_FILES_SOURCE is set to "none".'
  exit 0
fi

if [ ! -d "${VORTEX_FETCH_FILES_DIR}" ]; then
  task "Creating directory ${VORTEX_FETCH_FILES_DIR}."
  mkdir -p "${VORTEX_FETCH_FILES_DIR}"
  pass "Created directory ${VORTEX_FETCH_FILES_DIR}."
fi

export VORTEX_FETCH_FILES_DIR
"$(dirname "${BASH_SOURCE[0]}")/${fetch_script}"

# The semaphore file marks a completed files fetch.
[ -n "${VORTEX_FETCH_FILES_SEMAPHORE:-}" ] && touch "${VORTEX_FETCH_FILES_SEMAPHORE}"

pass "Finished files fetch."
