#!/usr/bin/env bash
##
# Push database dump.
#
# This is a router script to call relevant scripts based on type.
#
# The database dump file is pushed to the storage the database is fetched
# from, set in VORTEX_FETCH_DB_SOURCE. Only the 'gdrive' and 's3' sources
# accept a push; the push is skipped for other sources.
#
# IMPORTANT! This script runs outside the container on the host system.
#
# shellcheck disable=SC1090,SC1091

t=$(mktemp) && export -p >"${t}" && set -a && . ./.env && if [ -f ./.env.local ]; then . ./.env.local; fi && set +a && . "${t}" && rm "${t}" && unset t

set -eu
[ "${VORTEX_DEBUG-}" = "1" ] && set -x

# Proceed with push.
#
# Set to 1 in the nightly CI job only, so the storage is refreshed once a day
# and never from a feature branch build.
VORTEX_PUSH_DB_PROCEED="${VORTEX_PUSH_DB_PROCEED:-}"

# Database fetch source, which is also the push destination.
VORTEX_FETCH_DB_SOURCE="${VORTEX_FETCH_DB_SOURCE:-url}"

# ------------------------------------------------------------------------------

# @formatter:off
info() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[36m[INFO] %s\033[0m\n" "${1}" || printf "[INFO] %s\n" "${1}"; }
note() { printf "       %s\n" "${1}"; }
task() { _TASK_START=$(date +%s); [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[34m[TASK] %s\033[0m\n" "${1}" || printf "[TASK] %s\n" "${1}"; }
pass() { _d=""; [ -n "${_TASK_START:-}" ] && _d=" ($(($(date +%s) - _TASK_START))s)" && unset _TASK_START; [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[32m[ OK ] %s%s\033[0m\n" "${1}" "${_d}" || printf "[ OK ] %s%s\n" "${1}" "${_d}"; }
fail() { [ "${TERM:-}" != "dumb" ] && tput colors >/dev/null 2>&1 && printf "\033[31m[FAIL] %s\033[0m\n" "${1}" || printf "[FAIL] %s\n" "${1}"; exit "${2:-1}"; }
# @formatter:on

info "Started database push."

[ "${VORTEX_PUSH_DB_PROCEED}" != "1" ] && pass "Skipped database push as VORTEX_PUSH_DB_PROCEED is not set to 1." && exit 0

case "${VORTEX_FETCH_DB_SOURCE}" in
  gdrive) push_script="vortex-push-db-gdrive" ;;
  s3) push_script="vortex-push-db-s3" ;;
  *) pass "Skipped database push as the \"${VORTEX_FETCH_DB_SOURCE}\" database source in VORTEX_FETCH_DB_SOURCE does not accept a push. Use one of: gdrive, s3." && exit 0 ;;
esac

# The pushed dump leaves the hosting and CI, so it must be sanitized.
[ "${VORTEX_PROVISION_SANITIZE_DB_SKIP:-}" = "1" ] && fail "Refused to push the database as VORTEX_PROVISION_SANITIZE_DB_SKIP is set to 1 and the database dump is not sanitized."

"$(dirname "${BASH_SOURCE[0]}")/${push_script}"

pass "Finished database push."
