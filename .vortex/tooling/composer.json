{
    "name": "drevops/vortex-tooling",
    "description": "Vortex 2.x tooling: scripts for Drupal projects (deploy, notify, provision, database operations, etc.).",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "alex@drevops.com",
            "homepage": "https://www.drevops.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/drevops/vortex",
    "support": {
        "issues": "https://github.com/drevops/vortex/issues",
        "source": "https://github.com/drevops/vortex"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "alexskrypnyk/file": "^1.3.0",
        "alexskrypnyk/phpunit-helpers": "^1.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drevops/phpcs-standard": "^1.1.0",
        "drupal/coder": "^9.0.1@alpha",
        "ergebnis/composer-normalize": "^2.54.0",
        "php-mock/php-mock-phpunit": "^2.16",
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "^12.5.40",
        "rector/rector": "^2.7.0",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "DrevOps\\VortexTooling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrevOps\\VortexTooling\\Tests\\": "tests/"
        }
    },
    "bin": [
        "src/vortex-check-worktree-changes",
        "src/vortex-convert-audit-sarif",
        "src/vortex-deploy",
        "src/vortex-doctor",
        "src/vortex-export-db",
        "src/vortex-fetch-db",
        "src/vortex-import-db",
        "src/vortex-info",
        "src/vortex-login",
        "src/vortex-login-container-registry",
        "src/vortex-logout",
        "src/vortex-notify",
        "src/vortex-provision",
        "src/vortex-push-db-image",
        "src/vortex-reset",
        "src/vortex-storybook",
        "src/vortex-task",
        "src/vortex-update"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "bump-after-update": true,
        "discard-changes": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "check-no-exit": "php check-no-exit.php",
        "lint": [
            "phpcs",
            "phpstan --memory-limit=2G",
            "rector --dry-run",
            "@check-no-exit"
        ],
        "lint-fix": [
            "rector",
            "phpcbf"
        ],
        "reset": "rm -Rf vendor",
        "test": "phpunit --no-coverage",
        "test-coverage": "php -d pcov.directory=. vendor/bin/phpunit"
    }
}
