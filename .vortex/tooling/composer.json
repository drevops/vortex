{
    "name": "drevops/vortex-tooling",
    "description": "Shell scripts and Drush listeners for Vortex-based Drupal projects (deploy, notify, provision, fetch/export DB, fetch files, production guard, etc.).",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "alex@drevops.com",
            "homepage": "https://www.drevops.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/drevops/vortex",
    "support": {
        "issues": "https://github.com/drevops/vortex/issues",
        "source": "https://github.com/drevops/vortex"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drevops/phpcs-standard": "^1.1.0",
        "drupal/coder": "^9.0.1",
        "drush/drush": "^13.8.0",
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "^12.5.40",
        "rector/rector": "^2.7.0"
    },
    "autoload": {
        "psr-4": {
            "DrevOps\\VortexTooling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrevOps\\VortexTooling\\Tests\\": "tests/"
        }
    },
    "bin": [
        "src/vortex-check-worktree-changes",
        "src/vortex-convert-audit-sarif",
        "src/vortex-deploy",
        "src/vortex-doctor",
        "src/vortex-export-db",
        "src/vortex-fetch-db",
        "src/vortex-fetch-files",
        "src/vortex-import-db",
        "src/vortex-info",
        "src/vortex-lighthouse",
        "src/vortex-login",
        "src/vortex-login-container-registry",
        "src/vortex-logout",
        "src/vortex-notify",
        "src/vortex-provision",
        "src/vortex-push-db",
        "src/vortex-push-db-image",
        "src/vortex-refresh-db",
        "src/vortex-reset",
        "src/vortex-storybook",
        "src/vortex-task",
        "src/vortex-update"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpstan --memory-limit=2G",
            "rector --dry-run"
        ],
        "lint-fix": [
            "rector",
            "phpcbf"
        ],
        "test": "phpunit --no-coverage",
        "test-coverage": "php -d pcov.directory=. vendor/bin/phpunit"
    }
}
