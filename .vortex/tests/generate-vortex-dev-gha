#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Generate .github/workflows/vortex-test-didi.yml from build-test-deploy.yml.
 *
 * Extracts the workflow settings, database and build jobs from the main
 * GitHub Actions workflow and assembles them into DIDI variant jobs in a
 * single test workflow.
 *
 * Usage:
 *   php .vortex/tests/generate-vortex-dev-gha         # Generate
 *   php .vortex/tests/generate-vortex-dev-gha --check  # Check
 */

// Fork pull requests get no registry credentials to push the database image.
const VARIANT_JOB_CONDITION = '${{ github.event_name == \'push\' || github.event.pull_request.head.repo.full_name == github.repository }}';

$check_mode = in_array('--check', $argv ?? []);

$root_dir = dirname(__DIR__, 2);
$source_file = $root_dir . '/.github/workflows/build-test-deploy.yml';
$output_file = $root_dir . '/.github/workflows/vortex-test-didi.yml';

$content = file_get_contents($source_file);
if ($content === FALSE) {
  fwrite(STDERR, sprintf("Error: Cannot read %s\n", $source_file));
  exit(1);
}

$lines = explode("\n", $content);

$settings = extract_settings($lines);
$database_job = extract_workflow_job($lines, '/^  database:/');
$build_job = extract_workflow_job($lines, '/^  build:/');
$db_image_base = extract_github_env_value(explode("\n", $database_job), 'VORTEX_DB_IMAGE_BASE');

$db_image = 'drevops/vortex-dev-mariadb-drupal-data-demo-destination-11.x';
// The tags differ from the CircleCI ones, so a build never pulls an image
// exported by the other provider.
$db_image_tag_fi = 'vortex-dev-didi-database-fi-gha';
$db_image_tag_ii = 'vortex-dev-database-ii-gha';

$output = implode("\n", [
  '# Auto-generated by .vortex/tests/generate-vortex-dev-gha',
  '# Source: .github/workflows/build-test-deploy.yml',
  '# Do not edit directly.',
  '#',
  '# This action is used for Vortex maintenance. It will not be used in the scaffolded project.',
  'name: Vortex - Test DIDI',
  '',
  'on:',
  '  push:',
  '    branches:',
  '      - main',
  '      - release/**',
  '      - project/**',
  "      - '*.x'",
  '  pull_request:',
  '    branches:',
  '      - main',
  '      - feature/**',
  '      - bugfix/**',
  '      - release/**',
  '      - project/**',
  "      - '*.x'",
  '',
  'concurrency:',
  '  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}',
  '  cancel-in-progress: true',
  '',
  $settings,
  '',
  'jobs:',
  '  # DIDI-FI variant jobs',
  build_variant_workflow_job($database_job, 'vortex-dev-didi-database-fi', [], [
    'VORTEX_FETCH_DB_SOURCE' => 'url',
    'VORTEX_FETCH_DB_FORCE' => 1,
    'VORTEX_DB_IMAGE' => $db_image,
    'VORTEX_DB_IMAGE_BASE' => $db_image_base,
    'COMPOSE_PROGRESS' => 'plain',
    'VORTEX_PUSH_CONTAINER_REGISTRY_IMAGE_TAG' => $db_image_tag_fi,
    'VORTEX_EXPORT_DB_CONTAINER_REGISTRY_PUSH_PROCEED' => 1,
    'VORTEX_CI_DB_CACHE_BRANCH' => 'vortex-dev-didi-fi',
  ]),
  '',
  build_variant_workflow_job($build_job, 'vortex-dev-didi-build-fi', build_job_replacements('vortex-dev-didi-build-fi', 'vortex-dev-didi-database-fi'), [
    'VORTEX_DB_IMAGE' => $db_image . ':' . $db_image_tag_fi,
    'VORTEX_CI_DB_CACHE_BRANCH' => 'vortex-dev-didi-fi',
    'DRUPAL_MIGRATION_SKIP' => 1,
  ]),
  '',
  '  # DIDI-II variant jobs',
  build_variant_workflow_job($database_job, 'vortex-dev-database-ii', [], [
    'VORTEX_FETCH_DB_SOURCE' => 'container_registry',
    'VORTEX_FETCH_DB_FORCE' => 1,
    'VORTEX_DB_IMAGE' => $db_image,
    'COMPOSE_PROGRESS' => 'plain',
    'VORTEX_PUSH_CONTAINER_REGISTRY_IMAGE_TAG' => $db_image_tag_ii,
    'VORTEX_EXPORT_DB_CONTAINER_REGISTRY_PUSH_PROCEED' => 1,
    'VORTEX_CI_DB_CACHE_BRANCH' => 'vortex-dev-didi-ii',
  ]),
  '',
  build_variant_workflow_job($build_job, 'vortex-dev-didi-build-ii', build_job_replacements('vortex-dev-didi-build-ii', 'vortex-dev-database-ii'), [
    'VORTEX_DB_IMAGE' => $db_image . ':' . $db_image_tag_ii,
    'VORTEX_CI_DB_CACHE_BRANCH' => 'vortex-dev-didi-ii',
    'DRUPAL_MIGRATION_SKIP' => 1,
  ]),
  '',
]);

if ($check_mode) {
  if (!file_exists($output_file)) {
    fwrite(STDERR, sprintf("Error: %s does not exist. Run without --check to generate.\n", $output_file));
    exit(1);
  }

  $existing = file_get_contents($output_file);
  if ($existing !== $output) {
    fwrite(STDERR, sprintf("Error: %s is out of date. Run 'php .vortex/tests/generate-vortex-dev-gha' to update.\n", $output_file));
    exit(1);
  }

  echo sprintf("OK: %s is up to date.\n", $output_file);
  exit(0);
}

file_put_contents($output_file, $output);
echo sprintf("Generated: %s\n", $output_file);

/**
 * Extract the workflow-level settings from the source lines.
 *
 * Takes the lines from the first 'defaults', 'env' or 'permissions' key up to
 * the 'jobs' key.
 *
 * @param list<string> $lines
 *   Source file lines.
 */
function extract_settings(array $lines): string {
  $start = NULL;
  $end = NULL;

  foreach ($lines as $i => $line) {
    if ($start === NULL && preg_match('/^(defaults|env|permissions):/', $line)) {
      $start = $i;
    }

    if ($start !== NULL && preg_match('/^jobs:/', $line)) {
      $end = $i;
      break;
    }
  }

  if ($start === NULL || $end === NULL) {
    fwrite(STDERR, "Error: Could not find workflow settings.\n");
    exit(1);
  }

  $result = array_slice($lines, $start, $end - $start);

  // Trim trailing blank lines.
  while (!empty($result) && trim(end($result)) === '') {
    array_pop($result);
  }

  return implode("\n", $result);
}

/**
 * Extract a job block from the source lines.
 *
 * @param list<string> $lines
 *   Source file lines.
 */
function extract_workflow_job(array $lines, string $pattern): string {
  $start = NULL;

  for ($i = 0, $count = count($lines); $i < $count; $i++) {
    if (preg_match($pattern, $lines[$i])) {
      $start = $i;
      break;
    }
  }

  if ($start === NULL) {
    fwrite(STDERR, sprintf("Error: Could not find job matching %s.\n", $pattern));
    exit(1);
  }

  $result = [$lines[$start]];

  for ($i = $start + 1, $count = count($lines); $i < $count; $i++) {
    $line = $lines[$i];
    // Stop at the next block at job level (2-space indent) or top level.
    if ($line !== '' && (preg_match('/^  \S/', $line) || preg_match('/^\S/', $line))) {
      break;
    }
    $result[] = $line;
  }

  // Trim trailing blank lines.
  while (!empty($result) && trim(end($result)) === '') {
    array_pop($result);
  }

  return implode("\n", $result);
}

/**
 * Extract the value a job step writes to $GITHUB_ENV for a variable.
 *
 * @param list<string> $lines
 *   Job block lines.
 */
function extract_github_env_value(array $lines, string $name): string {
  foreach ($lines as $line) {
    if (preg_match('/echo "' . preg_quote($name, '/') . '=([^"]+)"/', $line, $matches)) {
      return $matches[1];
    }
  }

  fwrite(STDERR, sprintf("Error: Could not find %s written to \$GITHUB_ENV.\n", $name));
  exit(1);
}

/**
 * Build a DIDI variant job YAML block from a source job block.
 *
 * @param string $job
 *   Source job block.
 * @param string $name
 *   Variant job name.
 * @param array<string, string> $replacements
 *   Replacement strings keyed by the string they replace.
 * @param array<string, string|int> $env
 *   Container environment variable overrides.
 */
function build_variant_workflow_job(string $job, string $name, array $replacements, array $env): string {
  $lines = explode("\n", $job);

  $lines[0] = sprintf('  %s:', $name);

  // The source condition reads workflow dispatch inputs, which this workflow
  // does not define.
  $lines[find_line($lines, '/^    if: /', 'job condition')] = '    if: ' . VARIANT_JOB_CONDITION;

  $job = implode("\n", set_container_env($lines, $env));

  foreach ($replacements as $search => $replace) {
    if (!str_contains($job, $search)) {
      fwrite(STDERR, sprintf("Error: Could not find '%s' in job %s.\n", $search, $name));
      exit(1);
    }

    $job = str_replace($search, $replace, $job);
  }

  return $job;
}

/**
 * Build the replacements for a build variant job.
 *
 * Both build variants run in the same workflow run, where an artifact name can
 * be uploaded once, so artifact and check run names carry the job name.
 *
 * @param string $name
 *   Variant job name.
 * @param string $database_job
 *   Name of the database variant job the build job needs.
 *
 * @return array<string, string>
 *   Replacement strings keyed by the string they replace.
 */
function build_job_replacements(string $name, string $database_job): array {
  return [
    'needs: database' => 'needs: ' . $database_job,
    'name: test-artifacts-' => sprintf('name: test-artifacts-%s-', $name),
    'name: code-artifact' => sprintf('name: code-artifact-%s', $name),
    'check_name: Test results (' => sprintf('check_name: Test results %s (', $name),
  ];
}

/**
 * Set variables in the container 'env' block of job block lines.
 *
 * Replaces the value of a variable already in the block and appends any other
 * variable to the end of the block.
 *
 * @param array<int, string> $lines
 *   Job block lines.
 * @param array<string, string|int> $env
 *   Environment variables to set.
 *
 * @return array<int, string>
 *   Job block lines with the variables set.
 */
function set_container_env(array $lines, array $env): array {
  $start = find_line($lines, '/^      env:$/', 'container environment', find_line($lines, '/^    container:$/', 'container'));

  // Block entries are indented by 8 spaces.
  $end = $start;
  for ($i = $start + 1, $count = count($lines); $i < $count && ($lines[$i] === '' || str_starts_with($lines[$i], '        ')); $i++) {
    if ($lines[$i] !== '') {
      $end = $i;
    }
  }

  $block = array_slice($lines, $start + 1, $end - $start, TRUE);

  $appended = [];
  foreach ($env as $key => $value) {
    $line = sprintf('        %s: %s', $key, $value);
    $existing = preg_grep('/^        ' . preg_quote($key, '/') . ':/', $block);

    if (empty($existing)) {
      $appended[] = $line;
      continue;
    }

    $lines[array_key_first($existing)] = $line;
  }

  array_splice($lines, $end + 1, 0, $appended);

  return $lines;
}

/**
 * Find the index of the first line matching a pattern.
 *
 * @param array<int, string> $lines
 *   Lines to search.
 * @param string $pattern
 *   Regular expression to match.
 * @param string $label
 *   Name of the searched item for the error message.
 * @param int $offset
 *   Index to start the search from.
 */
function find_line(array $lines, string $pattern, string $label, int $offset = 0): int {
  for ($i = $offset, $count = count($lines); $i < $count; $i++) {
    if (preg_match($pattern, $lines[$i])) {
      return $i;
    }
  }

  fwrite(STDERR, sprintf("Error: Could not find %s matching %s.\n", $label, $pattern));
  exit(1);
}
