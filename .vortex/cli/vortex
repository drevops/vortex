#!/usr/bin/env php
<?php

/**
 * @file
 * Vortex CLI entry point.
 */

declare(strict_types=1);

use DrevOps\PhpTui\Screen\Layout\DefaultLayout;
use DrevOps\PhpTui\Screen\Layout\LayoutManager;
use DrevOps\VortexCli\Command\BuildCommand;
use DrevOps\VortexCli\Command\ConfigureCommand;
use DrevOps\VortexCli\Command\DoctorCommand;
use DrevOps\VortexCli\Command\InstallCommand;
use DrevOps\VortexCli\Command\RouteCommand;
use DrevOps\VortexCli\Command\UpdateCommand;
use DrevOps\VortexCli\Utils\Config;
use DrevOps\VortexCli\Utils\Env;
use Symfony\Component\Console\Application;

require_once $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/vendor/autoload.php';

// Read through Env so the superseded variable name resolves through the same
// fallback every other configuration variable uses.
$version = (string) Env::get(Config::VERSION, '@vortex-cli-version@');

// Box replaces the placeholder when packaging the PHAR, so a version still
// carrying it means the CLI is running straight from source.
$version = str_contains($version, 'vortex-cli-version') ? 'development' : $version;

// The library finds its shipped layouts by globbing its own directory, and
// glob() returns nothing through the phar:// wrapper, so the layout every
// screen falls back to is registered by class for the packaged binary.
LayoutManager::register('default', DefaultLayout::class);

$application = new Application('Vortex CLI', $version);

$application->add(new InstallCommand());
$application->add(new UpdateCommand());
$application->add(new ConfigureCommand());
$application->add(new DoctorCommand());
$application->add(new BuildCommand());
$application->add(new RouteCommand());

$application->setDefaultCommand('route');

$application->run();
