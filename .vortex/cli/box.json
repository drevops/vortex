{
    "output": ".build/vortex.phar",
    "banner": [
        "@file",
        "Vortex CLI.",
        "",
        "<!-- -->",
        "CLI for <a href=\"https://github.com/drevops/vortex\">Vortex</a> project.<br/>",
        "Run in your terminal:<br/>",
        "<code>curl -SsL https://www.vortextemplate.com/install > vortex.phar && php vortex.phar</code><br/>",
        "More details: <a href=\"https://www.vortextemplate.com\">https://www.vortextemplate.com</a>",
        "<!--"
    ],
    "finder": [
        {
            "in": "./",
            "exclude": [
                "tests",
                "vendor-bin"
            ],
            "notName": "/.*\\.md|.*\\.xml|rector\\.php/"
        }
    ],
    "blacklist": [
        "box.json",
        "phpcs.xml",
        "phpstan.neon"
    ],
    "replacements": {
        "vortex-cli-version": "development"
    }
}
