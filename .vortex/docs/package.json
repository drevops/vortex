{
  "name": "vortex-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "vale sync",
    "docusaurus": "docusaurus",
    "start": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-dev docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear && DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-dev docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "spellcheck": "cspell \"content/**/*.mdx\"",
    "update-variables": "./.utils/update-docs.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "yarn lint-js && yarn lint-docs",
    "lint-fix": "yarn lint-js-fix && yarn lint-docs-fix",
    "lint-js": "eslint src/ tests/ && prettier --check src/ tests/",
    "lint-js-fix": "eslint src/ tests/ --fix && prettier --write src/ tests/",
    "lint-docs": "markdownlint-cli2 \"content/**/*.mdx\"",
    "lint-docs-fix": "markdownlint-cli2 \"content/**/*.mdx\" --fix",
    "lint-prose": "vale content"
  },
  "dependencies": {
    "@docusaurus/core": "^3.5",
    "@docusaurus/module-type-aliases": "^3.5",
    "@docusaurus/plugin-client-redirects": "^3.5",
    "@docusaurus/plugin-google-gtag": "^3.5",
    "@docusaurus/preset-classic": "^3.5",
    "@docusaurus/theme-mermaid": "^3.5",
    "@docusaurus/types": "^3.5",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "raw-loader": "^4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp-cli": "^6.1.0",
    "svg-term-cli": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.0.0",
    "@vvago/vale": "^3.22.0",
    "babel-jest": "^30.5.2",
    "cspell": "^9.8.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.19"
  }
}
