// audit-ci configuration for the custom theme of projects based on Vortex.
//
// Fails the security audit on npm advisories at or above the threshold, except
// the ones in the allowlist. An allowlist entry stops applying once its expiry
// date is reached.
//
// https://github.com/IBM/audit-ci
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Keep in step with 'audit-level' in '.npmrc', which 'npm audit' reads.
  "high": true,
  "extra-args": ["--package-lock-only"],
  "allowlist": [
    {
      "GHSA-vfj7-8cjw-p6xm": {
        "active": true,
        "notes": "No patched braces release exists yet. It is reached only through the theme's build and lint tooling (stylelint, chokidar-cli, postcss-cli and patch-package), which expands the glob patterns written in this project, so no outside input reaches it and nothing from it ships with the site.",
        "expiry": "2026-10-31"
      }
    }
  ]
}
